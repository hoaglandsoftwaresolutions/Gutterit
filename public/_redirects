# ---------------------------------------------------------------------------
# Old Wix URLs → new equivalents (301 permanent).
# Google still has the Wix index entries; these stop them from hard-404ing
# and pass their ranking signal to the right new page. ORDER MATTERS — more
# specific rules must come before wildcards, and all of this must come before
# the SPA fallback at the bottom.
# ---------------------------------------------------------------------------

# Wix booking page → our contact/quote page.
/book-online             /contact                       301

# The gutter-repair service page was renamed from /services/repair. Keep the
# old slug 301'd to the new URL so its existing index entry transfers.
/services/repair         /services/gutter-repair        301
/services/repair/        /services/gutter-repair        301

# Wix service pages lived under /service-page/<slug>. Map the ones we can
# resolve precisely, then catch the rest at the Services index.
# (The pressure-washing entry carries Wix's original "wahsing" typo.)
/service-page/pressure-wahsing    /services/pressure-washing    301
/service-page/pressure-washing    /services/pressure-washing    301
/service-page/gutter-installation /services/installation        301
/service-page/gutter-cleaning     /services/cleaning            301
/service-page/gutter-repair       /services/gutter-repair       301
/service-page/gutter-guards       /services/gutter-guards       301
/service-page/*                   /services                     301

# Wix portfolio / gallery pages no longer exist — send to home.
/portfolio-collections/*  /                             301
/portfolio                /                             301
/portfolio/*              /                             301
/gallery                  /                             301
/gallery/*                /                             301

# Legacy per-city service URLs are gone — funnel any inbound SEO traffic
# (or stale Google index entries) to the main Services page.
/cleaning-in-*           /services    301
/repair-in-*             /services    301
/installation-in-*       /services    301
/pressure-washing-in-*   /services    301

# ---------------------------------------------------------------------------
# Trailing-slash normalization. The canonical URLs have NO trailing slash
# (except root), so 301 the slashed variants to the no-slash version. These
# must come before the SPA fallback so the slashed path doesn't get a 200.
# ---------------------------------------------------------------------------
/services/                       /services                     301
/services/installation/          /services/installation        301
/services/cleaning/              /services/cleaning            301
/services/gutter-repair/         /services/gutter-repair       301
/services/gutter-guards/         /services/gutter-guards       301
/services/pressure-washing/      /services/pressure-washing    301
/about/                          /about                        301
/contact/                        /contact                      301

# ---------------------------------------------------------------------------
# Silo restructure (2026-06) — the extended Core-30 service pages moved off
# flat /services/<slug> into two top-level silo hubs. These slugs were never
# indexed, so these 301s are low-cost insurance, not load-bearing. The five
# CORE service pages stay at /services/<slug> and are intentionally NOT listed
# here — do NOT add a /services/* wildcard or it would catch them.
# ---------------------------------------------------------------------------
# Gutters silo — children
/services/gutter-replacement   /residential-gutter-services/gutter-replacement   301
/services/downspout-services   /residential-gutter-services/downspout-services   301
/services/gutter-leak-repair   /residential-gutter-services/gutter-leak-repair   301
/services/gutter-realignment   /residential-gutter-services/gutter-realignment   301
/services/gutter-inspection    /residential-gutter-services/gutter-inspection    301
/services/fascia-repair        /residential-gutter-services/fascia-repair        301
/services/soffit-repair        /residential-gutter-services/soffit-repair        301
/services/roof-debris-removal  /residential-gutter-services/roof-debris-removal  301
/services/drainage-solutions   /residential-gutter-services/drainage-solutions   301
# Gutters silo — hub root
/services/residential-gutter-services   /residential-gutter-services             301
# Exterior silo — children
/services/house-washing        /exterior-cleaning/house-washing       301
/services/roof-cleaning        /exterior-cleaning/roof-cleaning        301
/services/driveway-cleaning    /exterior-cleaning/driveway-cleaning    301
/services/deck-fence-cleaning  /exterior-cleaning/deck-fence-cleaning  301

# /locations renamed to /service-areas (pages were unindexed; courtesy 301).
/locations            /service-areas         301
/locations/*          /service-areas/:splat  301

# Cloudflare Pages serves static files filesystem-first, so prerendered
# routes like /services/index.html are served directly. This SPA fallback
# only fires for paths with no matching static file.
/*    /index.html    200
